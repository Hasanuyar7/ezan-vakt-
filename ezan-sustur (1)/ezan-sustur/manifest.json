{
  "manifest_version": 3,
  "name": "Ezan Sustur",
  "version": "1.1",
  "description": "Ezan vakti geldiğinde açık sekmelerdeki müziği/videoyu otomatik duraklatır.",
  "permissions": ["alarms", "storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>", "https://api.aladhan.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ezan Sustur",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
